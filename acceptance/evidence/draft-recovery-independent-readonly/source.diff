+import {afterEach,describe,it,expect,vi} from 'vitest';
+import {DraftAutosaver} from '../../src/shared/draftAutosaver';
+afterEach(()=>vi.useRealTimers());
+describe('new draft checkpoint scheduling',()=>{
+ it('does not write hydration or untouched empty input, coalesces typing, and has no idle timer',async()=>{vi.useFakeTimers();const write=vi.fn(async()=>{}),a=new DraftAutosaver('',write,vi.fn());await vi.advanceTimersByTimeAsync(10000);expect(write).not.toHaveBeenCalled();a.update('中');await vi.advanceTimersByTimeAsync(500);a.update('中文😀');await vi.advanceTimersByTimeAsync(799);expect(write).not.toHaveBeenCalled();await vi.advanceTimersByTimeAsync(1);expect(write).toHaveBeenCalledExactlyOnceWith('中文😀');await vi.advanceTimersByTimeAsync(10000);expect(write).toHaveBeenCalledTimes(1);});
+ it('checkpoints continuously changing input within max wait',async()=>{vi.useFakeTimers();const write=vi.fn(async()=>{}),a=new DraftAutosaver('',write,vi.fn());for(let i=0;i<8;i++){a.update(String(i));await vi.advanceTimersByTimeAsync(250);}expect(write).toHaveBeenCalledExactlyOnceWith('7');a.dispose();});
+ it('does not send IME intermediate text while paused, resumes complete text',async()=>{vi.useFakeTimers();const write=vi.fn(async()=>{}),a=new DraftAutosaver('',write,vi.fn());a.update('旧');a.pause();a.update('拼音');await vi.advanceTimersByTimeAsync(5000);expect(write).not.toHaveBeenCalled();a.update('中文');a.resume();await vi.advanceTimersByTimeAsync(0);expect(write).toHaveBeenCalledExactlyOnceWith('中文');});
+ it('serializes outstanding writes and flushes the newest full value',async()=>{vi.useFakeTimers();let release!:()=>void;const seen:string[]=[];const a=new DraftAutosaver('',async v=>{seen.push(v);if(v==='1')await new Promise<void>(r=>release=r);},vi.fn());a.update('1');await vi.advanceTimersByTimeAsync(800);a.update('2');a.update('3');await vi.advanceTimersByTimeAsync(3000);expect(seen).toEqual(['1']);const flush=a.flush();release();await flush;expect(seen).toEqual(['1','3']);await vi.advanceTimersByTimeAsync(10000);expect(seen).toEqual(['1','3']);});
+ it('keeps failed content dirty without a failure spin and allows retry flush',async()=>{vi.useFakeTimers();let fail=true;const error=vi.fn(),write=vi.fn(async()=>{if(fail)throw Error('readonly');}),a=new DraftAutosaver('',write,error);a.update('保留');await vi.advanceTimersByTimeAsync(800);expect(error).toHaveBeenCalledTimes(1);await vi.advanceTimersByTimeAsync(10000);expect(write).toHaveBeenCalledTimes(1);fail=false;await a.flush();expect(write).toHaveBeenCalledTimes(2);});
