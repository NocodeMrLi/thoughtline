+  } catch (error) {
+    result.error = String(error?.stack || error);
+    throw error;
+  } finally {
+    try {
+      if (app) {
+        pids.push(...await app.evaluate(({ app }) => app.getAppMetrics().map(metric => metric.pid)));
+        await app.close();
+        normalClose = true;
+      }
