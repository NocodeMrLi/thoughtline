+export type ActionName='copy'|'edit'|'archive'|'split'|'more'|'calendar'|'undo'|'delete'|'back'|'settings'|'restore';
+const paths:Record<ActionName,string>={copy:'M7 7h11v13H7z M4 16H2V2h11v2',edit:'m14 3 3 3 M4 13l10-10a2 2 0 0 1 3 3L7 16l-4 1z',archive:'M2 4h16v4H2z M4 8v10h12V8 M8 11h4',split:'M9 4H3v15h12v-6 M11 2h7v7 M18 2l-9 9',more:'M3 10h.01 M10 10h.01 M17 10h.01',calendar:'M3 4h14v14H3z M3 8h14 M6 2v4 M14 2v4 M6 11h2 M12 11h2 M6 14h2',undo:'M7 3 2 8l5 5 M2 8h10a5 5 0 0 1 0 10',delete:'M3 5h14 M7 5V2h6v3 M5 5l1 13h8l1-13 M8 8v7 M12 8v7',back:'m12 3-7 7 7 7 M5 10h13',settings:'M7 3h6l1 3 3 1v6l-3 1-1 3H7l-1-3-3-1V7l3-1z M10 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6',restore:'M3 8a7 7 0 1 1 0 5 M3 3v5h5 M10 6v5h4'};
+export function ActionIcon({name}:{name:ActionName}){return <svg width="18" height="18" viewBox="0 0 20 22" aria-hidden="true" fill="none" stroke="currentColor" strokeWidth={name==='more'?3:1.35} strokeLinecap="round" strokeLinejoin="round"><path d={paths[name]}/></svg>;}
+export function IconButton({icon,label,...props}:{icon:ActionName;label:string}&ButtonHTMLAttributes<HTMLButtonElement>){
+ const button=useRef<HTMLButtonElement>(null),[position,setPosition]=useState<{left:number;top:number;width:number}|null>(null);
+ const show=()=>{const r=button.current?.getBoundingClientRect();if(!r)return;const width=Math.min(280,innerWidth-16);setPosition({left:Math.max(8,Math.min(innerWidth-width-8,r.x+r.width/2-width/2)),top:r.top>80?r.top-62:Math.min(innerHeight-68,r.bottom+6),width});};
+ return <><button {...props} ref={button} className={`icon-button ${props.className??''}`} aria-label={label} title={label} onMouseEnter={e=>{show();props.onMouseEnter?.(e);}} onMouseLeave={e=>{setPosition(null);props.onMouseLeave?.(e);}} onFocus={e=>{show();props.onFocus?.(e);}} onBlur={e=>{setPosition(null);props.onBlur?.(e);}}><ActionIcon name={icon}/></button>{position&&createPortal(<span className="icon-tooltip" role="tooltip" style={{position:'fixed',...position}}>{label}</span>,document.body)}</>;
+}
