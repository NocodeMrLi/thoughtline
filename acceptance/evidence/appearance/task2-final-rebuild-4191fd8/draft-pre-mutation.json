ub.com/users/NocodeMrLi/repos","events_url":"https://api.github.com/users/NocodeMrLi/events{/privacy}","received_events_url":"https://api.github.com/users/NocodeMrLi/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":1792736,"digest":"sha256:10b0d9f2b001edbe971300f9e649c252ef4c3002be12594cdc285245b613cc3e","download_count":1,"created_at":"2026-10-09T17:22:42Z","updated_at":"2026-10-09T17:22:43Z","browser_download_url":"https://github.com/NocodeMrLi/thoughtline/releases/download/untagged-7b463588e2b0a177b25d/Windows-source-UI-evidence.zip"}],"tarball_url":null,"zipball_url":null,"body":"# Thoughtline 0.0.17-preview.3 — private review draft\n\nThis candidate adds Chinese/English UI and day/night appearance controls in the Composer, Detail and Calendar windows, with Follow system in Settings. Preferences persist separately from notes; user text and custom names are preserved. The desktop paper remains matte.\n\nBoth packages were rebuilt from frozen source `d9cf75b425464589e6761abd8dff9954f3e2ad0c` (225-input canonical vector `7b658b2d8a88b499c722bfe51a9bba0889b13673e0ee0661364f4eb5129764cc`). Mac arm64 DMG and Windows x64 NSIS installer passed isolated actual-package checks, including English/dark persistence across restart; the Windows runner also passed same-version reinstall and ordinary-uninstall data preservation. See `QA-guide-v0.0.17-preview.3.md`, `release-manifest.json` and `SHA256SUMS` before testing.\n\nMac is ad-hoc signed and not notarized. Windows app and installer are unsigned. The Windows installer uses the existing app identity and may replace an installed version: use a separate test environment. Physical IME, DPI, multi-display, focus, natural motion and real WeChat/Doubao/WorkBuddy reception are still open for independent acceptance. This draft is for final review and must remain private/unpublished until the controller completes that review.\n"}